{
  "manifest_version": 3,
  "name": "PiP Toggle",
  "version": "1.1",
  "description": "Toggle Picture-in-Picture on the active tab. Installed from dotfiles.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Picture-in-Picture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Toggle Picture-in-Picture"
    }
  }
}
